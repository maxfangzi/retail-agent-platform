# 复制本文件为 .env 并填入真实值。.env 已被 .gitignore 排除，绝不提交。
# Mistral API（console.mistral.ai → API Keys 创建；等号后面留空，把 key 粘贴到 .env 的这一行）
MISTRAL_API_KEY=

# 模型（省 token 方案：两档都用 small。预算充足时 premium 可换 mistral-large-latest）
LLM_MODEL_PREMIUM=mistral-small-latest
LLM_MODEL_FAST=mistral-small-latest

# RAG
CHROMA_PERSIST_DIR=./chroma_db
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# 数据库
DATABASE_URL=sqlite:///./data/agent_platform.db

# Langfuse（观测/追踪，本地 Docker 启动后填这里；没有就留空=关闭tracing）
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# 服务
API_HOST=0.0.0.0
API_PORT=8000
